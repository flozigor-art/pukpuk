# Public address of the CRM (used for secure cookies). Must be https in production.
CRM_PUBLIC_URL=https://crm.example.com
# Domain for the bundled Caddy (profile "caddy"); same host as above, without https://
CRM_DOMAIN=crm.example.com

# Shared secret of the storage node. Generate: openssl rand -hex 32
# The same value goes to NODE_TOKEN on the PC.
CRM_NODE_TOKEN=

# Disk budget on the VPS (the VPS is small; the PC keeps the real archive)
CRM_BUFFER_MAX=8GB      # uploads waiting to be moved to the PC; new uploads are refused above this
CRM_CACHE_MAX=4GB       # local copies of files already on the PC (LRU, for fast viewing)
CRM_PREVIEW_MAX=2GB     # light preview videos (LRU)
CRM_DISK_RESERVE=1GB    # always keep this much free space on the disk
CRM_WARM_MAX=128MB      # files up to this size are cached on the VPS after being viewed
CRM_MAX_FILE=6GB        # largest single file (raw footage, project archives)
CRM_CHUNK_SIZE=8MB      # upload chunk; the reverse proxy must accept bodies of this size

# Time zone of the publication plan (days start at midnight here)
CRM_TZ=Europe/Moscow
