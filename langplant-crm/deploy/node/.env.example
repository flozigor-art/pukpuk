# Address of the CRM on the VPS
NODE_SERVER_URL=https://crm.example.com
# Same value as CRM_NODE_TOKEN on the VPS
NODE_TOKEN=

# Folder on this PC where the archive lives (big disk). Examples:
#   Windows (Docker Desktop):  D:/LangPlant
#   macOS:                     /Users/sasha/LangPlant
#   Linux:                     /mnt/media/langplant
STORAGE_PATH=./storage

# Longest side of preview videos generated for quick viewing on phones
NODE_PREVIEW_HEIGHT=960
# Parallel downloads from the VPS buffer
NODE_DOWNLOADS=2
# Database backups pulled from the VPS (kept in STORAGE_PATH/backups)
NODE_BACKUP_INTERVAL=6h
NODE_BACKUP_KEEP=60
# Files deleted forever in the CRM stay in STORAGE_PATH/trash for this many days
NODE_TRASH_DAYS=30
